{
  "name": "mailbox-agent-langgraph-samva",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable example of a LangGraph agent that reads a Samva mailbox and answers each message with tools, held for a person's approval, on email and WhatsApp.",
  "type": "module",
  "scripts": {
    "agent": "bun src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.4",
    "@langchain/core": "^1.4.0",
    "@langchain/langgraph": "^1.7.3",
    "langchain": "^1.6.5",
    "samva": "^0.43.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
