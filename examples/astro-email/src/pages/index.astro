---
import { actions, isInputError } from "astro:actions";

const sendResult = Astro.getActionResult(actions.send);
const fieldErrors = isInputError(sendResult?.error) ? sendResult.error.fields : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro Email + Samva</title>
    <style>
      :root {
        color: #1f2937;
        background: #f6f7f9;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        margin: 0;
      }

      main {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 32px 16px;
      }

      section {
        width: min(100%, 640px);
        border: 1px solid #d8dde6;
        border-radius: 8px;
        background: #ffffff;
        padding: 32px;
        box-shadow: 0 16px 40px rgba(31, 41, 55, 0.08);
      }

      h1 {
        margin: 0;
        color: #111827;
        font-size: 32px;
        line-height: 1.1;
      }

      p {
        line-height: 1.6;
      }

      form {
        display: grid;
        gap: 16px;
        margin-top: 24px;
      }

      label {
        display: grid;
        gap: 6px;
        font-weight: 600;
      }

      input,
      textarea {
        border: 1px solid #c7ceda;
        border-radius: 6px;
        padding: 10px 12px;
        color: #111827;
        font: inherit;
      }

      textarea {
        min-height: 120px;
        resize: vertical;
      }

      button {
        justify-self: start;
        border: 0;
        border-radius: 6px;
        background: #111827;
        color: #ffffff;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
        padding: 10px 16px;
      }

      .status {
        border-radius: 6px;
        margin-top: 20px;
        padding: 12px 14px;
      }

      .success {
        background: #ecfdf3;
        color: #075e32;
      }

      .error {
        background: #fef2f2;
        color: #991b1b;
      }

      .field-error {
        color: #b91c1c;
        font-size: 14px;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <main>
      <section>
        <h1>Send email from Astro</h1>
        <p>
          This form posts to an Astro Action and sends through Samva from server code. Samva uses the
          verified sender on your account, so the payload has no <code>from</code> field.
        </p>

        {
          sendResult?.data?.ok && (
            <p class="status success" role="status">
              Message accepted by Samva.
            </p>
          )
        }

        {
          sendResult?.error && (
            <p class="status error" role="alert">
              {sendResult.error.message}
            </p>
          )
        }

        <form method="POST" action={actions.send}>
          <label>
            Recipient email
            <input type="email" name="email" required placeholder="ada@example.com" />
            {fieldErrors?.email && <span class="field-error">{fieldErrors.email.join(", ")}</span>}
          </label>

          <label>
            Subject
            <input name="subject" required placeholder="Hello from Astro" />
            {
              fieldErrors?.subject && (
                <span class="field-error">{fieldErrors.subject.join(", ")}</span>
              )
            }
          </label>

          <label>
            Message
            <textarea name="message" required placeholder="Write the email body"></textarea>
            {
              fieldErrors?.message && (
                <span class="field-error">{fieldErrors.message.join(", ")}</span>
              )
            }
          </label>

          <button type="submit">Send email</button>
        </form>
      </section>
    </main>
  </body>
</html>
