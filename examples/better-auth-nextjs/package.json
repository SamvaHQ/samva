{
  "name": "better-auth-nextjs-samva",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js Better Auth route handler that sends auth email through Samva.",
  "type": "module",
  "scripts": {
    "build": "SAMVA_API_KEY=samva_sk_test_build_placeholder BETTER_AUTH_SECRET=build-secret-at-least-32-characters BETTER_AUTH_URL=http://localhost:3000 next build --webpack",
    "dev": "next dev",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@better-auth/memory-adapter": "^1.7.17",
    "@samva/better-auth": "workspace:*",
    "better-auth": "^1.7.17",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "samva": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
