{
  "name": "mailbox-agent-eve-samva",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable example of an Eve agent on Vercel that answers a Samva mailbox on email and WhatsApp from one process, replies held for a person's approval.",
  "type": "module",
  "scripts": {
    "dev": "eve dev",
    "build:agent": "eve build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "4.42.0",
    "@chat-adapter/state-redis": "4.42.0",
    "@samva/eve": "workspace:*",
    "ai": "^7.0.170",
    "chat": "4.42.0",
    "eve": "^1.0.0-rc.10",
    "samva": "^0.48.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
