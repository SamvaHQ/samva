# A mailbox-scoped Samva API key with the approval rule { match: { effect: "write" }, atLeast: "person" }.
SAMVA_API_KEY=samva_sk_live_your_key_here
# The mailbox the bot answers.
SAMVA_MAILBOX_ID=mbx_your_mailbox_id
# The signing secret of the webhook that delivers mailbox.message.received.
SAMVA_WEBHOOK_SECRET=whsec_your_webhook_secret
