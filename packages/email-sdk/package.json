{
  "name": "@samva/email-sdk",
  "version": "0.1.1",
  "description": "Samva community adapter for Email SDK.",
  "keywords": [
    "email",
    "email-sdk",
    "samva",
    "transactional-email"
  ],
  "homepage": "https://samva.dev",
  "bugs": {
    "url": "https://github.com/SamvaHQ/samva/issues"
  },
  "license": "MIT",
  "author": "Arya Labs, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamvaHQ/samva.git",
    "directory": "packages/email-sdk"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "package.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --external samva --external @opencoredev/email-sdk",
    "prepack": "bun run build",
    "dev": "tsdown src/index.ts --format esm --dts --watch --external samva --external @opencoredev/email-sdk",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@opencoredev/email-sdk": "^1.1.0",
    "samva": "^0.5.0"
  },
  "peerDependencies": {
    "@opencoredev/email-sdk": "^1.1.0",
    "samva": "^0.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
