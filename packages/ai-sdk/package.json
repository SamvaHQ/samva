{
  "name": "@samva/ai-sdk",
  "version": "0.1.1",
  "description": "AI SDK tools for Samva mailboxes.",
  "keywords": [
    "agent",
    "ai",
    "ai-sdk",
    "email",
    "mailbox",
    "samva",
    "tools",
    "vercel-ai-sdk",
    "whatsapp"
  ],
  "homepage": "https://samva.dev/docs/mailboxes/vercel-ai-sdk",
  "bugs": {
    "url": "https://github.com/SamvaHQ/samva/issues"
  },
  "license": "MIT",
  "author": "Arya Labs, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamvaHQ/samva.git",
    "directory": "packages/ai-sdk"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "package.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "bun run build",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.170",
    "samva": "^0.48.0"
  },
  "peerDependencies": {
    "ai": "^7.0.170",
    "samva": "^0.48.0"
  },
  "engines": {
    "node": ">=22"
  }
}
